# 支付服务环境变量模板
#
# 使用方式：cp .env.example .env 后填入真实值。.env 已被 gitignore，不会进仓库。
# 本文件只列键名与示例，严禁写入任何真实密钥。
#
# 加载方式说明：本服务不内置 .env 解析，需要由部署环境注入。
# 本地开发可用 `set -a; source .env; set +a` 或 docker --env-file 加载。

# ---------- 服务运行 ----------
# 配置文件路径，留空则用 configs/config.yaml
PAYMENT_CONFIG=configs/config.yaml
# debug | release | test
PAYMENT_SERVER_MODE=debug
PAYMENT_SERVER_HOST=0.0.0.0
PAYMENT_SERVER_PORT=8080
PAYMENT_LOG_LEVEL=info
PAYMENT_LOG_FORMAT=console

# ---------- 支付通用 ----------
# mock | wechatpay
PAYMENT_DEFAULT_CHANNEL=mock
# 回调地址域名前缀，必须公网可达、HTTPS、已 ICP 备案
PAYMENT_NOTIFY_BASE_URL=https://pay.example.com

# ---------- 微信支付 ----------
# 是否启用微信支付渠道，骨架阶段保持 false
WECHATPAY_ENABLED=false
# 公众号 / 小程序 AppID
WECHATPAY_APP_ID=
# 商户号
WECHATPAY_MCH_ID=
# 商户 API 证书序列号（证书模式）
WECHATPAY_MCH_CERT_SERIAL_NO=
# 商户私钥路径，指向 certs/ 下的 apiclient_key.pem
WECHATPAY_PRIVATE_KEY_PATH=certs/apiclient_key.pem
# 微信支付公钥 ID 与公钥文件路径（公钥模式，与证书模式二选一）
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=
# 回调路径
WECHATPAY_NOTIFY_PATH=/api/v1/callbacks/wechatpay

# APIv3 密钥，固定 32 位，用于回调报文的 AES-256-GCM 解密
# 这是唯一只能来自环境变量的配置项，配置文件中不存在对应字段
WECHATPAY_API_V3_KEY=
